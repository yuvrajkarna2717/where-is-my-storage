{
  "name": "storage-visualizer-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Storage Visualizer.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
